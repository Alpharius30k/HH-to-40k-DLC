            "typeId": "7e03-38c2-7fea-e955",
            "typeName": "Psychic Abilities",
            "characteristics": [
              {
                "name": "Descriptions",
                "$text": "In your Shooting phase, if this unit is not battle-shocked, you can make a psychic roll for this unit by rolling one D6. If you do:\n\n\n- On a 1, this unit is battle-shocked.\n- Select one enemy unit within 12” of this model. That unit makes a battle-shock roll with -1 to that battle-shock roll.",
                "typeId": "1917-301f-5d49-2f76"
              }
            ]
          },
          {
            "name": "Whispers of the Shadow Forest (psychic level 1)",
            "id": "c1c1-d559-ad8f-450c",
            "hidden": false,
            "typeId": "7e03-38c2-7fea-e955",
            "typeName": "Psychic Abilities",
            "characteristics": [
              {
                "name": "Descriptions",
                "$text": "When an enemy unit targets this unit, if this unit is not battle-shocked, you can make a psychic roll for this unit by rolling one D6. If you do:\n\n- On a 1, this unit is battle-shocked.\n- Attacks that target this unit have -1 to hit rolls until the end of the phase.",
