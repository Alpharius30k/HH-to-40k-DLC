    "sharedRules": [
      {
        "name": "Psyker",
        "id": "f6a5-0223-cd27-f1f4",
        "description": "Units with this ability have a **psyker level** of 1 or higher, specified in that unit's abilities. Each **psychic ability** has a **psychic level** of 1 or higher, specified in that ability's name.\nIn a battle round, a friendly **PSYKER** unit can use a number of **psychic abilities** whose total **psychic level** does not exceed that **PSYKER** unit's **psyker level**.",
        "hidden": false
      }
    ],
