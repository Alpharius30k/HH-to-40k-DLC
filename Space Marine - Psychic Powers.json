        "type": "upgrade",
        "profiles": [
          {
            "name": "Mist-wreathed Shadow Realms (Psychic level 2)",
            "id": "afad-3ae2-c541-7c71",
            "hidden": false,
            "typeId": "7e03-38c2-7fea-e955",
            "typeName": "Psychic Abilities",
            "characteristics": [
              {
                "name": "Descriptions",
                "$text": "In your Command phase, if this unit is unengaged and not **battle-shocked**, you can use this ability. If you do make a **psychic roll** on 1D6: \n- On a a 1: **Lion El'Jonson: Lord of the First** is **Battle-shocked**\n\n- Else:Place this unit in strategic reserves.  This unit can make an ingress move in your next Movement phase (including in your first turn).",
                "typeId": "1917-301f-5d49-2f76"
              }
            ]
          },
          {
            "name": "Mystic Wilds (Psychic Level 3)",
            "id": "dab9-240c-af76-f189",
            "hidden": false,
            "typeId": "7e03-38c2-7fea-e955",
            "typeName": "Psychic Abilities",
            "characteristics": [
              {
                "name": "Descriptions",
                "$text": "In your Command phase, if this unit is not **battle-shocked**, you can use this ability. If you do make a **psychic roll** on 1D6: \n- On a 1: **Lion El'Jonson: Lord of the First** is **Battle-shocked**\n- Else: All friendly **Dark Angels Infantry** models withing 6\" can **re-roll hit** and **wound rolls** of 1",
                "typeId": "1917-301f-5d49-2f76"
              }
            ]
          },
          {
            "name": "Mystic Wilds (Psychic Level 3)",
            "id": "8a8e-4b80-5f15-c694",
            "hidden": false,
            "typeId": "7e03-38c2-7fea-e955",
            "typeName": "Psychic Abilities",
            "characteristics": [
              {
                "name": "Descriptions",
                "$text": "In your Command phase, if this unit is unengaged and not **battle-shocked**, you can use this ability. If you do make a **psychic roll** on 1D6: \n- On a a 1: **Lion El'Jonson: Lord of the First** is **Battle-shocked**\n\n\n- Else: While a friendly ^^**Dark Angels**^^ unit is within 6\" of this unit, that unit has Feel No Pain 5+ against **psychic** attacks and **mortal** wounds.",
                "typeId": "1917-301f-5d49-2f76"
