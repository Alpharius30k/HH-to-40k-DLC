        "name": "Corvus Corax",
        "id": "0db7-5327-9cb8-a805",
        "hidden": false,
        "constraints": [{"id": "1113-2849-afdb-c25e", "field": "selections", "includeChildSelections": true, "scope": "force", "shared": true, "type": "max", "value": 1}]
