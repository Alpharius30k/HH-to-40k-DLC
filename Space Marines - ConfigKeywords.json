    "sharedProfiles": [
      {
        "name": "Battlesmith x+",
        "id": "6b28-e707-4237-e961",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": "If this model is not **battle-shocked** you can use this ability in your command phase. Select 1 **vehicle** or **walker** model withing 3\" of this model then make a **repair roll** on 1D6:\n- On a x+: **Heal(1)**",
            "typeId": "9b8f-694b-e5e-b573"
          }
        ]
      },
      {
        "name": "Master of Automata",
        "id": "ef4d-8ac0-dafa-6942",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [{"name": "Description", "$text": "This model can join **Infantry Walker** units as well as its regular leader options.", "typeId": "9b8f-694b-e5e-b573"}]
      },
      {
        "name": "Bitter Defence",
        "id": "a2f6-5a57-3e2c-f832",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": "When a model with this ability is **charged** for the rest of the turn increase the number of **melee** attacks by 1",
            "typeId": "9b8f-694b-e5e-b573"
          }
        ]
      },
      {
        "name": "Marked for Death",
        "id": "a436-a1a2-392a-dffb",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": "You can give a Mark of Death to a number of **enemy** units equal to the amount of **friendly** units with this ability. **Friendly** models with this ability can re-roll failed **wound** rolls of 1 against **enemy** units with **Mark of Death**.",
            "typeId": "9b8f-694b-e5e-b573"
          }
        ]
      },
      {
        "name": "Power of the machine Spirit",
        "id": "c4da-0da3-9742-8597",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": "If you use a **strategem** on this model before its shooting attack that give it a benefit for targeting a specific unit it applies to every unit this model targets.\n\n\n[Example: If you used a **strategem** on this model that requires you to select 1 target and this model would gain +1 to hit against it instead all targets this model shoots act as if they where effected]",
            "typeId": "9b8f-694b-e5e-b573"
          }
        ]
      },
      {
        "name": "Sons of the Emperor",
        "id": "a83b-8c46-b484-53a5",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": "This model has all these abilities:\n- If this model is on more then 1 wound and an attack would cause it to fall below 1 wound it instead reduces it to 1 wound\n- This models **Leadership** can not be modified\n- At the end of your turn roll a D6 and on a 5+ restore 1 wound on this model\n- This model counts as 4 for transport capacity",
            "typeId": "9b8f-694b-e5e-b573"
          }
        ]
      },
      {
        "name": "Adamantium Will x+",
        "id": "623a-2bda-6a71-8392",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": "**Models** with this ability have a **[Feel No Pain X+]** where x is the number in the ability against **Psychic** wounds from all sources",
            "typeId": "9b8f-694b-e5e-b573"
          }
        ]
      },
      {
        "name": "Bloody Murder",
        "id": "7d26-7f68-a67c-63eb",
        "hidden": false,
        "typeId": "9cc3-6d83-4dd3-9b64",
        "typeName": "Abilities",
        "characteristics": [
          {
            "name": "Description",
            "$text": "When making a charge roll reduce the distance to **pinned** or **battleshocked** by 1\" and improve the number of attacks this unit has by 1 when targetting thouse units.",
            "typeId": "9b8f-694b-e5e-b573"
          }
        ]
      }
    ],
    "sharedRules": [
      {
        "name": "Pinned",
        "id": "412b-0358-c6d1-ed7e",
        "description": "A **unit** that is **pinned** has -2\" to its movment and advance and charge roll. This lasts for 1 **battle round**",
        "hidden": false
      },
      {
        "name": "Pinning",
        "id": "a4b9-9c88-086f-205e",
        "description": "A unit that receives 1 or more damage from a weapon with this become **pinned**",
        "hidden": false
      },
      {
        "name": "Heal(x)",
        "id": "dcba-26c2-51f4-f429",
        "description": "When a unit is affected by this ability resolve the following X times\n- If a model is below full wounds, restore 1 wound to it\n- If every model is at full wounds and this unit has destroyed models, return 1 destroyed model to this unit with 1 wound remaining.",
        "hidden": false
      },
      {"name": "Overcharge", "id": "bbaf-981c-4f63-44d0", "description": "If a weapon with this ability makes a **hazardous** test -1 to the roll", "hidden": false},
      {
        "name": "Conversion",
        "id": "e4f3-ccfc-842e-0cce",
        "description": "ach time an attack made with this weapon targets a unit more than half the weapons range from the bearer, an unmodified successful Hit roll of 4+ scores a Critical Hit.",
        "hidden": false
      },
      {
        "name": "Rad-Phage",
        "id": "eb66-1fe7-18ff-3369",
        "description": "A unit that has taken 1 or more wounds from a weapon with this ability have -1 toughness till the end of the phase but does not stack with itself but does with all other modifers.",
        "hidden": false
      },
      {
        "name": "Burst",
        "id": "f73e-424c-e4d9-73f4",
        "description": "If a weapon **succsesfully** hits its target every **sucsesful** hit triggers **[Sustained Hits]** even if its not a **critical Hits**. **Critical Hits** do not trigger this ability as they already trigger **[Sustained Hits]**",
        "hidden": false
      }
    ],
